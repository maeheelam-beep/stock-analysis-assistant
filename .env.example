# 复制为 .env.local 后填写。不要把真实密钥提交到版本库。
# 直连 DeepSeek 时填写 API Key；使用自有安全中转时可留空。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：VPS 直连 DeepSeek 受阻时，填写自有 Worker 的完整 HTTPS 接口地址和独立中转口令。
# 示例地址：https://gujiluo-deepseek-relay.<account>.workers.dev/v1/chat/completions
DEEPSEEK_RELAY_URL=
DEEPSEEK_RELAY_TOKEN=

# 可选：上游地址调整时可在服务器环境覆盖。
MARKET_API_BASE_URL=https://push2.eastmoney.com
NOTICE_API_BASE_URL=https://np-anotice-stock.eastmoney.com
FAST_NEWS_API_BASE_URL=https://np-weblist.eastmoney.com

# 可选：填写天聚数据财经新闻 API 密钥后自动加入第三方授权资讯源。
TIANAPI_KEY=
